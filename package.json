{
  "name": "react-json-eye",
  "version": "2.0.1",
  "type": "module",
  "description": "React JSON document renderer with sections, inline renderers and translations.",
  "main": "./dist/json-eye.js",
  "module": "./dist/json-eye.js",
  "exports": {
    ".": "./dist/json-eye.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "PUBLISHING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "node tests/render.test.mjs",
    "lint": "eslint src demo",
    "prepack": "npm run check",
    "test:package": "node --test tests/package.test.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:package && npm run build:demo",
    "dev": "vite demo --config demo/vite.config.js --host 127.0.0.1",
    "build:demo": "vite build demo --config demo/vite.config.js --outDir ../demo-dist"
  },
  "keywords": [
    "react",
    "json",
    "renderer"
  ],
  "author": "Mirozlav",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "@emotion/react": "^11.14.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "vite": "^8.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mirozzzlav/json-eye.git"
  },
  "homepage": "https://github.com/mirozzzlav/json-eye#readme",
  "bugs": {
    "url": "https://github.com/mirozzzlav/json-eye/issues"
  }
}
